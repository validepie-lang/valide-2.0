# ============================================================
# SISTEMA VALIDE - Configuracao de Banco de Dados
# ============================================================
# Escolha qual banco usar:
#   sqlite   -> Testes rapidos / offline (PADRAO se nao existir arquivo)
#   postgres -> Supabase / producao
# ============================================================

DB_ENGINE=sqlite

# ===== SQLite (usado se DB_ENGINE=sqlite) =====
# Caminho relativo ou absoluto para o arquivo do banco
SQLITE_PATH=./data/valide.db

# ===== PostgreSQL / Supabase (usado se DB_ENGINE=postgres) =====
# OBS: No Supabase, pegue esses dados em:
#   https://supabase.com/dashboard/project/_/settings/database
#   Secao: "Connection string" -> URI / Parameters

# Host (ex: db.abcdef1234.supabase.co)
SUPABASE_HOST=

# Porta (padrao Supabase = 5432)
SUPABASE_PORT=5432

# Database name (padrao Supabase = postgres)
SUPABASE_DB=postgres

# Username (padrao Supabase = postgres)
SUPABASE_USER=postgres

# Password (a "Database Password" / senha master do Supabase)
SUPABASE_PASSWORD=

# SSL (deixe "require" para Supabase Cloud)
SUPABASE_SSLMODE=require
